# Supabase（service_role key。サーバー側だけで使い、フロントには出さない）
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_KEY=xxxx

# Health Auto Export の REST API 自動化で送るトークン
# （Headers に "Authorization: Bearer <値>" を設定）
WEBHOOK_TOKEN=change-me

# ダッシュボード / API 用の Basic 認証（未設定なら認証なし＝ローカル開発用）
BASIC_AUTH_USER=me
BASIC_AUTH_PASSWORD=change-me
