# Neon の接続文字列（Neon ダッシュボード → Connect でコピー。サーバー側だけで使う）
DATABASE_URL=postgresql://user:password@ep-xxxx.aws.neon.tech/neondb?sslmode=require

# テスト用 DB（pytest が毎回 TRUNCATE するので本番とは別の DB / ブランチを指定）
# TEST_DATABASE_URL=postgresql://postgres@localhost:5432/apphealth_test

# Health Auto Export の REST API 自動化で送るトークン
# （Headers に "Authorization: Bearer <値>" を設定）
WEBHOOK_TOKEN=change-me

# ダッシュボード / API 用の Basic 認証（未設定なら認証なし＝ローカル開発用）
BASIC_AUTH_USER=me
BASIC_AUTH_PASSWORD=change-me

# ワークアウトを「何日の運動か」に変換するタイムゾーン（省略時 Asia/Tokyo）
# APP_TIMEZONE=Asia/Tokyo
